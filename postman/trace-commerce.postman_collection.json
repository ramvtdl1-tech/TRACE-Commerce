  "item": [
    {
      "name": "01 Read-only discovery",
      "description": "Safe default discovery. No model request, PayPal order or capture. Keep the cookie jar enabled.",
      "item": [
        {
          "name": "Read configuration and establish session",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/config",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "config"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(() => {",
                  "pm.test('Configuration responds successfully', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test('Modes are explicit', () => { pm.expect(data.mode).to.be.oneOf(['rehearsal','sandbox']); pm.expect(data.ai_mode).to.be.oneOf(['local','provider']); });",
                  "pm.test('Merchant and model secrets are not returned', () => { ['paypal_client_secret','paypal_client_id','ai_api_key','access_token'].forEach(key => pm.expect(data).not.to.have.property(key)); });",
                  "pm.collectionVariables.set('csrf_token', data.csrf_token || '');",
                  "pm.collectionVariables.set('payment_mode', data.mode || '');",
                  "pm.collectionVariables.set('ai_mode', data.ai_mode || '');",
                  "})();"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
        {
          "name": "Read authoritative catalog",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/catalog",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "catalog"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(() => {",
                  "pm.test('Catalog responds successfully', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test('Catalog is USD with integer-cent prices', () => { pm.expect(data.currency).to.eql('USD'); pm.expect(data.items).to.be.an('array').that.is.not.empty; data.items.forEach(item => { pm.expect(Number.isInteger(item.price_cents)).to.eql(true); pm.expect(item.price_cents).to.be.above(0); }); });",
                  "const prices = {}; (data.items || []).forEach(item => { prices[item.id] = item.price_cents; });",
                  "pm.collectionVariables.set('catalog_prices', JSON.stringify(prices));",
                  "})();"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
