                  "pm.test('Merchant and model secrets are not returned', () => { ['paypal_client_secret','paypal_client_id','ai_api_key','access_token'].forEach(key => pm.expect(data).not.to.have.property(key)); });",
                  "pm.collectionVariables.set('csrf_token', data.csrf_token || '');",
                  "pm.collectionVariables.set('payment_mode', data.mode || '');",
                  "pm.collectionVariables.set('ai_mode', data.ai_mode || '');",
