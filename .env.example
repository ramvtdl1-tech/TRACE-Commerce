# Works without credentials for a clearly labeled local rehearsal.
# For the actual hackathon demo, change BOTH modes and provide real sandbox/AI credentials.
PAYMENT_MODE=rehearsal
AI_MODE=local
PUBLIC_BASE_URL=http://127.0.0.1:8000
COOKIE_SECURE=false
DATABASE_PATH=data/commerce.sqlite3

# PayPal Developer dashboard -> Apps & Credentials -> Sandbox (never Live).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Any compatible chat-completions model; choose a model available in your account.
AI_BASE_URL=https://api.tokenfactory.nebius.com/v1
AI_API_KEY=
AI_MODEL=
AI_MAX_TOKENS=4000
# Existing NEBIUS_API_KEY, NEBIUS_BASE_URL and NEBIUS_MODEL are accepted as aliases.
# A .env in the parent TRACE AI project is intentionally not loaded.
