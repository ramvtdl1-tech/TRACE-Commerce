          "if (!(/^https:\\/\\/[^\\/?#@]+\\/?$/.test(base) || /^http:\\/\\/(localhost|127\\.0\\.0\\.1|\\[::1\\])(:[0-9]+)?\\/?$/.test(base))) { console.warn('Skipped: base_url must be an HTTPS origin or HTTP localhost origin without credentials/path.'); pm.execution.skipRequest(); }",
