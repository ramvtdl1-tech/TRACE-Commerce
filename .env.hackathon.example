# Actual hackathon integration profile. Copy only if .env does not already exist.
# This profile intentionally will not start until private credentials are supplied.
PAYMENT_MODE=sandbox
AI_MODE=provider
PUBLIC_BASE_URL=http://127.0.0.1:8000
COOKIE_SECURE=false
DATABASE_PATH=data/commerce.sqlite3

# PayPal Dashboard -> Apps & Credentials -> Sandbox, not Live.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

AI_BASE_URL=https://api.tokenfactory.nebius.com/v1
AI_API_KEY=
# Choose an available model. Previously verified: nvidia/Nemotron-3_5-Lightning
AI_MODEL=
AI_MAX_TOKENS=4000

# Hosted deployment: set the exact HTTPS origin above and COOKIE_SECURE=true.
