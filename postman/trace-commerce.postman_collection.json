        {
          "name": "Manual: request one real AI plan",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrf_token}}"
              },
              {
                "key": "Origin",
                "value": "{{base_url}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/plans",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "plans"
              ]
            },
            "description": "Set collection variable manual_action=generate_ai_plan immediately before Send. Uses one provider request.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prompt\": \"Build a calm home office for video calls under $300\",\n  \"budget_cents\": 30000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(() => {",
                  "const requestedAction = pm.collectionVariables.get('manual_action') || '';",
                  "pm.collectionVariables.unset('manual_action');",
                  "if (pm.collectionVariables.get('payment_mode') !== 'sandbox' || pm.collectionVariables.get('ai_mode') !== 'provider' || !pm.collectionVariables.get('csrf_token') || requestedAction !== \"generate_ai_plan\") { console.warn('Skipped: configure provider + sandbox and enter the documented one-shot manual_action for this exact request.'); pm.execution.skipRequest(); }",
                  "})();"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "(() => {",
                  "pm.test('Plan responds successfully', () => pm.response.to.have.status(200));",
                  "const plan = pm.response.json();",
                  "const prices = JSON.parse(pm.collectionVariables.get('catalog_prices') || '{}');",
                  "pm.test('Plan prices and totals come from the catalog and respect $300', () => {",
                  "  pm.expect(plan.items).to.be.an('array').that.is.not.empty;",
                  "  pm.expect(plan.budget_cents).to.eql(30000);",
                  "  let total = 0; const seen = new Set();",
                  "  plan.items.forEach(item => { pm.expect(seen.has(item.product_id)).to.eql(false); seen.add(item.product_id); pm.expect(item.unit_price_cents).to.eql(prices[item.product_id]); pm.expect(Number.isInteger(item.quantity)).to.eql(true); pm.expect(item.quantity).to.be.within(1,5); pm.expect(item.line_total_cents).to.eql(prices[item.product_id] * item.quantity); total += item.line_total_cents; });",
                  "  pm.expect(plan.total_cents).to.eql(total); pm.expect(total).to.be.at.most(30000); pm.expect(plan.remaining_cents).to.eql(30000-total);",
                  "});",
                  "pm.test('Planner source is correctly labeled', () => pm.expect(plan.ai_source).to.eql(pm.collectionVariables.get('ai_mode') === 'provider' ? 'provider' : 'local'));",
                  "if (pm.response.code === 200 && plan.id) { pm.collectionVariables.set('plan_id', plan.id); pm.collectionVariables.set('cart_items', JSON.stringify(plan.items.map(item => ({product_id:item.product_id,quantity:item.quantity})))); pm.collectionVariables.set('plan_total', String(plan.total_cents)); }",
                  "})();"
                ]
              }
            }
          ],
          "protocolProfileBehavior": {
            "followRedirects": false
          }
        },
